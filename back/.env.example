# === APP ===
APP_NAME="LifeLine"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

# === LOCALE ===
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# === DATABASE ===
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=lifeline
DB_USERNAME=root
DB_PASSWORD=

# === SESSION ===
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# === CACHE ===
CACHE_STORE=database
CACHE_PREFIX=

# === LOGGING ===
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# === SECURITY ===
BCRYPT_ROUNDS=12

# === MAINTENANCE ===
APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

# === QUEUE & BROADCAST ===
BROADCAST_CONNECTION=log
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# === MAIL ===
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# === VITE ===
VITE_APP_NAME="${APP_NAME}"

# === CORS ===
CORS_ALLOWED_ORIGINS=http://localhost:8100,http://localhost:8104,http://localhost:5173

# === ADMIN SEED ===
ADMIN_PASSWORD=changeme123
ADMIN_EMAIL=admin@admin.com
ADMIN_NAME=Admin

# === SSO (tu-org/sso-server) ===
SSO_CLIENT_ID=lifeline
SSO_CLIENT_SECRET=
SSO_URL=http://localhost:8001/api
SSO_JWT_ISSUER=http://localhost:8001
JWKS_CACHE_TTL=3600