# Application
APP_NAME="LifeLine"
APP_DEBUG=true
APP_URL=http://localhost
APP_KEY=

# Logging
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database
DB_CONNECTION=sqlite
DB_DATABASE=:memory:

# Session
SESSION_DRIVER=array

# Cache
CACHE_STORE=array

# Mail
MAIL_MAILER=log

# SSO Server (Authentication)
SSO_URL=http://localhost:8001/api
SSO_JWT_ISSUER=http://localhost:8001
JWKS_CACHE_TTL=3600

# Miscellaneous
APP_MAINTENANCE_DRIVER=file
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
